# Copier en .env (jamais commité). Pour passer de l'un à l'autre, ne changer que LLM_PROVIDER.
LLM_PROVIDER=ollama
# LLM_PROVIDER=openrouter

OLLAMA_MODEL=llama3.1:8b
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=sk-or-...

# Ollama : fenêtre de contexte (tokens). Les deux : délai max par appel (secondes).
LLM_NUM_CTX=8192
LLM_TIMEOUT=300
